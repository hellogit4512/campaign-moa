{
  "manifest_version": 3,
  "name": "쿠팡 리뷰 작성기 도우미",
  "version": "1.0.1",
  "description": "쿠팡 주문목록과 상품평을 자동으로 읽어 리뷰 작성기에 채워 줘요. 쿠팡에 글을 쓰거나 누르는 일은 하지 않아요.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://*.coupang.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "쿠팡 주문·상품평 가져오기" },
  "content_scripts": [
    {
      "matches": ["https://hellogit4512.github.io/campaign-moa/review-writer/*", "http://localhost:5181/review-writer/*"],
      "js": ["bridge.js"],
      "run_at": "document_end"
    }
  ]
}
